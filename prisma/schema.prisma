generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String           @id @default(cuid())
  name           String?
  email          String           @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  accounts       Account[]
  sessions       Session[]
  recipes        Recipe[]
  weekPlans      WeekPlan[]
  memberships    PlanMembership[]
  suggestions    MealSuggestion[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Recipe {
  id           String             @id @default(cuid())
  title        String
  description  String?            @db.Text
  instructions String?            @db.Text
  servings     Int                @default(4)
  prepTime     Int?
  cookTime     Int?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients  RecipeIngredient[]
  mealSlots    MealSlot[]
  suggestions  MealSuggestion[]
}

model Ingredient {
  id      String             @id @default(cuid())
  name    String             @unique
  recipes RecipeIngredient[]
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  quantity     Float
  unit         String
  notes        String?
  recipeId     String
  ingredientId String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([recipeId, ingredientId, unit])
}

model WeekPlan {
  id          String           @id @default(cuid())
  weekStart   DateTime
  status      String           @default("draft")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  ownerId     String
  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  mealSlots   MealSlot[]
  groceryList GroceryList?
  memberships PlanMembership[]
  suggestions MealSuggestion[]

  @@unique([ownerId, weekStart])
}

model MealSlot {
  id         String   @id @default(cuid())
  day        Int
  mealType   String
  weekPlanId String
  recipeId   String
  weekPlan   WeekPlan @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model PlanMembership {
  id         String   @id @default(cuid())
  email      String
  role       String   @default("member")
  status     String   @default("pending")
  weekPlanId String
  userId     String?
  weekPlan   WeekPlan @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([weekPlanId, email])
}

model MealSuggestion {
  id          String   @id @default(cuid())
  day         Int
  mealType    String
  note        String?
  status      String   @default("pending")
  weekPlanId  String
  recipeId    String
  suggestedBy String
  weekPlan    WeekPlan @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  recipe      Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [suggestedBy], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model GroceryList {
  id         String            @id @default(cuid())
  shared     Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  weekPlanId String            @unique
  weekPlan   WeekPlan          @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  items      GroceryListItem[]
}

model GroceryListItem {
  id            String      @id @default(cuid())
  name          String
  quantity      Float?
  unit          String?
  checked       Boolean     @default(false)
  isManual      Boolean     @default(false)
  groceryListId String
  groceryList   GroceryList @relation(fields: [groceryListId], references: [id], onDelete: Cascade)
}
